# ParaBene local settings. Copy to .env (not committed) and edit:
#   cp .env.example .env
# The extension reads .env on install and on every reload in chrome://extensions
# and writes these values into its settings (changes made in the panel last until
# the next reload). Every line is optional; unknown or invalid values are skipped.

# Filter on/off (true | false)
# PARABENE_ENABLED=true

# Local AI model (true | false)
PARABENE_AI_ENABLED=true

# Request format: simple ({"text"} -> {"hide", "reason"}) | basal (basal-serve)
#   | builtin (no server: the model runs in the browser on WebGPU, ~1.2 GB downloaded once; the endpoint is not used)
PARABENE_AI_PROTOCOL=basal

# Endpoint. For basal the bare server address is enough (/v1/basal is appended).
PARABENE_AI_ENDPOINT=http://localhost:8000

# How keywords and the AI model work together:
#   both (keywords hide at once, the model checks the rest) | ai (the model alone, keywords only as fallback)
# PARABENE_AI_MODE=both

# basal-serve: sensitivity (low = threshold 0.7 | medium = 0.5 | high = 0.3)
# PARABENE_AI_SENSITIVITY=medium

# basal-serve: hidden topics, comma-separated (empty = none):
#   accident, violence, death, profanity, politics, clickbait
# PARABENE_AI_TOPICS=accident,violence,death,profanity

# Image evaluation by a multimodal basal-serve server (true | false), shares sensitivity and topics:
#   basal-serve --model Remek/basal-omni-1.0-mini --mode eager --media on --port 8011
# PARABENE_AI_IMAGES_ENABLED=false
# PARABENE_AI_IMAGES_ENDPOINT=http://localhost:8011

# Log of hidden content, exported from the panel as a .jsonl file (true | false)
# PARABENE_LOG_ENABLED=false

# Learning from revealed content (true | false): content revealed with "Show anyway" and not hidden
# again lets similar content through; similarity: strict (0.45) | medium (0.33) | loose (0.2)
# PARABENE_LEARN_ENABLED=false
# PARABENE_LEARN_SIMILARITY=medium

# UI language (pl | en)
# PARABENE_LANGUAGE=pl
